# Backend Configuration
PORT=5000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# Option A — Railway MySQL plugin (set DATABASE_URL to the value of $MYSQL_URL)
# DATABASE_URL=mysql://user:password@host:port/dbname

# Option B — individual vars (used when DATABASE_URL is not set)
DB_DIALECT=mysql        # set to "sqlite" for local dev without MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=coffee_shop_db
DB_USER=root
DB_PASSWORD=
DB_STORAGE=./database.sqlite   # only used when DB_DIALECT=sqlite

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRE=7d

# ── URLs ──────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000   # set to your Vercel frontend URL in production
